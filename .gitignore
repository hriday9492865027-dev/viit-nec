# Next.js build output cache
Frontend/.next/
Backend/.next/
.next/

# Dependencies
Frontend/node_modules/
Backend/node_modules/
node_modules/

# Build outputs
Frontend/dist/
*.tsbuildinfo

# Local database / JSON data files (NEVER commit real data)
Frontend/data/*.json
Backend/data/*.json
data/*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# ─── Environment / Secrets (NEVER commit these) ───────────────────
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.cert

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp

