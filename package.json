{
  "name": "viit-nec-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cd Frontend && npm install && npm run build",
    "dev": "cd Frontend && npm run dev",
    "dev:backend": "cd Backend && npm run dev",
    "dev:all": "concurrently --names \"FRONTEND,BACKEND\" --prefix-colors \"cyan,green\" \"npm run dev\" \"npm run dev:backend\"",
    "start:backend": "cd Backend && npm start",
    "install:all": "npm install && cd Frontend && npm install && cd ../Backend && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
